# See https://git-scm.com/docs/gitignore for pattern syntax

# Node modules
/node_modules/
/**/node_modules/

# Build outputs
/build/
/dist/
/out/                # sometimes used
/.next/              # if mixing Next in same repo (ignore for pure React)
/public/build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependency directories (lock files)
package-lock.json
yarn.lock
pnpm-lock.yaml

# IDE / Editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
Thumbs.db

# Temp / cache
.cache/
.tmp/
*.tmp
*.temp

# Coverage reports
coverage/
lcov-report/

# Misc
*.tsbuildinfo
*.swp
*.swo

# If using local builds for storybook or docs
.storybook/out/

# Optional: specifically re-include assets you want
# !/public/favicon.ico

